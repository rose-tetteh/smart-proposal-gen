# Template for .env. Copy this file to .env and fill in the real values there.
# .env is git-ignored and holds secrets; this file is committed and must never
# contain a real key.
#
# Server-side only: do NOT rename these with a VITE_ prefix, or Vite will
# bundle them into the browser code where anyone can read the key.

# Base URL including /v1, e.g. https://<amaliai-api-host>/v1
AMALIAI_BASE_URL=https://<amaliai-api-host>/v1

# Your AmaliAI API key (sent as "Authorization: Bearer <key>")
AMALIAI_API_KEY=<your-amaliai-api-key>

# Which model does each job. The first name is the main model; any names
# after a comma are backups, tried in order if it fails. Reload the app after
# a change (no restart needed). Keep WRITE in one model family so the tone
# of the proposal stays consistent.

# Proposal sections (client-facing)
AMALIAI_MODEL_WRITE=gpt-5.6-terra,gpt-5.6-luna,qwen3p8-max
# Reading the RFP: details and requirements
AMALIAI_MODEL_EXTRACT=gpt-5.6-terra,qwen3p8-max
# Chat, rewrites and win themes
AMALIAI_MODEL_ASSIST=gpt-5.6-luna,gpt-5.6-terra,deepseek-v4p1-flash
# Fact check before export (a different maker from WRITE). glm-5p3-flash checks
# a batch in ~35s; qwen3p8-max is more thorough but slower, so it's the backup.
AMALIAI_MODEL_FACTCHECK=glm-5p3-flash,qwen3p8-max

# Team passcode. When set, the app asks for it before anyone can use the AI
# (so a shared link can't spend the key). Leave empty locally to skip the screen.
APP_PASSCODE=
# Optional: signs the 14-day "remember me" cookie. If empty, the passcode is used.
# Changing it logs everyone out.
AUTH_SECRET=
